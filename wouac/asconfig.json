{
  "targets": {
    "debug": {
      "outFile":       "dist/wouac.debug.wasm",
      "textFile":      "dist/wouac.debug.wat",
      "sourceMap":     true,
      "debug":         true
    },
    "release": {
      "outFile":       "dist/wouac.wasm",
      "optimizeLevel": 3,
      "shrinkLevel":   0,
      "converge":      false,
      "noAssert":      true
    }
  },
  "options": {
    "stackSize": 1048576,
    "lib":     "./node_modules/@assemblyscript/wasi-shim/assembly",
    "use":     [
      "ASC_WASI=1",
      "abort=wasi_abort",
      "trace=wasi_trace",
      "seed=wasi_seed",
      "console=wasi_console",
      "crypto=wasi_crypto",
      "performance=wasi_performance",
      "process=wasi_process",
      "Date=wasi_Date"
    ],
    "runtime": "stub"
  }
}
