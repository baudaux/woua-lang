;; Test: i32.store8 / i32.load8_u
;; Writes individual bytes into an allocated buffer and reads them back.
;; Expected output: ABC

(include std_io)

(defn main ()
  (let buf :ptr (alloc 4)
    (i32.store8 (+ buf 0) 65)  ;; 'A'
    (i32.store8 (+ buf 1) 66)  ;; 'B'
    (i32.store8 (+ buf 2) 67)  ;; 'C'
    (i32.store8 (+ buf 3) 10)  ;; '\n'
    (let iov :Iovec (alloc (+ (sizeof Iovec) 4))
      (Iovec/base! iov buf)
      (Iovec/len!  iov 4)
      (drop (fd_write 1 (as :i32 iov) 1 (+ (as :i32 iov) (sizeof Iovec)))))))
