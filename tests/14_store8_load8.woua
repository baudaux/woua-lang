;; @test store8-load8
;; @feature write and read individual bytes with i32.store8 / i32.load8_u
;; @expect ABC

(include io)

(defn main ()
  (let buf :ptr (alloc 4)
    (i32.store8 (+ buf 0) 'A')
    (i32.store8 (+ buf 1) 'B')
    (i32.store8 (+ buf 2) 'C')
    (i32.store8 (+ buf 3) '\n')
    (let iov :*Iovec (alloc (+ (sizeof Iovec) 4))
      (Iovec/base! iov buf)
      (Iovec/len!  iov 4)
      (drop (fd_write 1 (as :i32 iov) 1 (+ (as :i32 iov) (sizeof Iovec)))))))
