;; @test slice_basic
;; @feature :T[N] auto-alloc slice, :T[] fat-pointer param, aref, aset!, alen, defstatic :T[N], struct element type
;; @expect
;;   alen=4
;;   buf[0]=0
;;   buf[1]=10
;;   buf[2]=20
;;   buf[3]=30
;;   sum=60
;;   static[0]=7
;;   static[2]=21
;;   static_len=3
;;   vec[0].x=1 .y=2
;;   vec[1].x=3 .y=4
;;   vec_len=2

(include io)

;; Custom struct type
(deftype Vec2
  (x :i32)
  (y :i32))

;; defstatic :i32[3] — 3 elements in linear memory; (alen TABLE) folds to 3
(defstatic TABLE :i32[3])

;; defstatic :Vec2[2] — 2 Vec2 elements (16 bytes); aref returns :*Vec2 slot address
(defstatic VECS :Vec2[2])

;; Sum all elements in a :i32[] slice
(defn sum-slice (xs :i32[]) :i32
  (let* ((acc :i32 0)
         (i   :i32 0))
    (while (< i (alen xs))
      (set! acc (+ acc xs[i]))
      (set! i (+ i 1)))
    acc))

(defn main () :void
  ;; :T[N] auto-alloc — 4 i32 elements
  (let buf :i32[4]
    (printf "alen=%d\n" (alen buf))
    (printf "buf[0]=%d\n" buf[0])     ;; freshly allocated → 0
    (aset! buf 0 0)
    (aset! buf 1 10)
    (aset! buf 2 20)
    (aset! buf 3 30)
    (printf "buf[1]=%d\n" buf[1])
    (printf "buf[2]=%d\n" buf[2])
    (printf "buf[3]=%d\n" buf[3])
    ;; Pass :i32[] fat-pointer to a function
    (printf "sum=%d\n" (sum-slice buf))
    ;; defstatic :T[N]
    (aset! TABLE 0 7)
    (aset! TABLE 1 14)
    (aset! TABLE 2 21)
    (printf "static[0]=%d\n" TABLE[0])
    (printf "static[2]=%d\n" TABLE[2])
    (printf "static_len=%d\n" (alen TABLE))
    ;; defstatic :Vec2[N] — aref returns :*Vec2 slot address; use struct accessors
    (Vec2/x! VECS[0] 1)
    (Vec2/y! VECS[0] 2)
    (Vec2/x! VECS[1] 3)
    (Vec2/y! VECS[1] 4)
    (printf "vec[0].x=%d .y=%d\n" (Vec2/x VECS[0]) (Vec2/y VECS[0]))
    (printf "vec[1].x=%d .y=%d\n" (Vec2/x VECS[1]) (Vec2/y VECS[1]))
    (printf "vec_len=%d\n" (alen VECS))))
