;; @test i32-to-string
;; @feature convert i32 to string including zero, negative, and min/max values
;; @expect
;;   0
;;   42
;;   -1
;;   2147483647
;;   -2147483648

(include io)

(defn main ()
  (print-string (i32->string 0))
  (print "\n")
  (print-string (i32->string 42))
  (print "\n")
  (print-string (i32->string -1))
  (print "\n")
  (print-string (i32->string 2147483647))
  (print "\n")
  (print-string (i32->string -2147483648))
  (print "\n"))
