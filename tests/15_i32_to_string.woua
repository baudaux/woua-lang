;; @test i32-to-string
;; @feature convert i32 to string including zero, negative, and min/max values
;; @expect
;;   0
;;   42
;;   -1
;;   2147483647
;;   -2147483648

(include io)

(defn main ()
  (printf "%s\n" (i32->str 0))
  (printf "%s\n" (i32->str 42))
  (printf "%s\n" (i32->str -1))
  (printf "%s\n" (i32->str 2147483647))
  (printf "%s\n" (i32->str -2147483648)))
