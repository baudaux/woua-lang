;; Test: while loop
;; Counts from 1 to 5, printing each value.
;; Verifies the (while cond body...) form with set! mutation.
;; Expected output:
;;   1
;;   2
;;   3
;;   4
;;   5

(include std_io)

(defn main ()
  (let i :i32 1
    (while (<= i 5)
      (print-int i)
      (print "\n")
      (set! i (+ i 1)))))
