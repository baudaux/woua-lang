;; @test static-string
;; @feature string literals are interned at compile time and deduplicated
;; @expect
;;   hello
;;   same ptr: 1

(include io)

(defn main ()
  (print "hello\n")
  ;; Both occurrences of "hello\n" must share the same static pointer.
  (if (= (static-ptr "hello\n") (static-ptr "hello\n"))
    (print "same ptr: 1\n")
    (print "same ptr: 0\n")))
