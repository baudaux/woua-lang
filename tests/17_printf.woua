;; @test printf
;; @feature printf with %s, %d, %ld, %%, %c format specifiers
;; @expect
;;   hello world!
;;   n = 42
;;   big = 1000000000000
;;   100% done
;;   char: A

(include io)

(defn main ()
  (let name :str "world"
    (let n :i32 42
      (let big :i64 1000000000000i64
        (printf "hello %s!\n" name)
        (printf "n = %d\n" n)
        (printf "big = %ld\n" big)
        (printf "100%% done\n")
        (printf "char: %c\n" 'A')))))
