;; @test as
;; @feature cast between numeric types with (as :Type expr)
;; @expect 2500000

(include io)

(defn main ()
  (let a :i32 50000
    (let b :i64 (* (as :i64 a) (as :i64 a))  ;; 2,500,000,000 — overflows i32
      (let c :i32 (as :i32 (/ b 1000i64))    ;; 2,500,000 — fits in i32
        (printf "%d\n" c)))))
