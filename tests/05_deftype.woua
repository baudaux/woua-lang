;; @test deftype
;; @feature declare a struct type; :*Point allocates on heap via constructor
;; @expect
;;   x: 10
;;   y: 20

(include io)

(deftype Point
  (x :i32)
  (y :i32))

(defn main () :void
  (let p :*Point (Point 10 20)
    (printf "x: %d\n" (Point/x p))
    (printf "y: %d\n" (Point/y p))))
