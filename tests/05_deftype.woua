;; Test: deftype + field accessors
;; Declares a struct type with two fields, allocates it on the heap,
;; sets and reads each field by name using the generated accessor macros.
;; Expected output:
;;   x: 10
;;   y: 20

(include io)

(deftype Point
  (x :i32)
  (y :i32))

(defn main ()
  (let p :Point (alloc (sizeof Point))
    (Point/x! p 10)
    (Point/y! p 20)
    (printf "x: %d\n" (Point/x p))
    (printf "y: %d\n" (Point/y p))))
