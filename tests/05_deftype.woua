;; @test deftype
;; @feature declare a struct type and access fields via generated accessor macros
;; @expect
;;   x: 10
;;   y: 20

(include io)

(deftype Point
  (x :i32)
  (y :i32))

(defn main ()
  (let p :Point (alloc (sizeof Point))
    (Point/x! p 10)
    (Point/y! p 20)
    (printf "x: %d\n" (Point/x p))
    (printf "y: %d\n" (Point/y p))))
