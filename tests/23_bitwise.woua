;; @test bitwise
;; @feature bitwise not/!/xor/band/bor/bxor/&/|/^ operators for i32 and i64
;; @expect
;;   ! 0 = 1
;;   ! 1 = 0
;;   & 6 3 = 2
;;   | 6 3 = 7
;;   ^ 6 3 = 5
;;   ! 0i64 = 1
;;   & 6i64 3i64 = 2
;;   | 6i64 3i64 = 7
;;   ^ 6i64 3i64 = 5

(include io)

(defn main ()
  (printf "! 0 = %d\n" (! 0))
  (printf "! 1 = %d\n" (! 1))
  (printf "& 6 3 = %d\n" (& 6 3))
  (printf "| 6 3 = %d\n" (| 6 3))
  (printf "^ 6 3 = %d\n" (^ 6 3))
  (printf "! 0i64 = %d\n" (! 0i64))
  (printf "& 6i64 3i64 = %d\n" (as :i32 (& 6i64 3i64)))
  (printf "| 6i64 3i64 = %d\n" (as :i32 (| 6i64 3i64)))
  (printf "^ 6i64 3i64 = %d\n" (as :i32 (^ 6i64 3i64))))
