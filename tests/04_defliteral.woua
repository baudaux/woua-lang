;; Test: defliteral
;; Exercises every numeric literal form declared in core.woua:
;;   int (:i32), negative int, int64 (:i64 with i64 suffix), float (:f32), float value,
;;   float64 (:f64 with f64 suffix), hex (:i32 with 0x prefix), hex64, string (:string :static).
;; Expected output:
;;   int ok
;;   neg ok
;;   i64 ok
;;   f32 ok
;;   f32 val: -1.5
;;   f64 ok
;;   hex ok
;;   hex64 ok
;;   string ok

(include std_io)

(defn main ()
  (if (= 42 42)
    (print "int ok\n")
    (print "int fail\n"))
  (if (= -7 -7)
    (print "neg ok\n")
    (print "neg fail\n"))
  (if (= 100i64 100i64)
    (print "i64 ok\n")
    (print "i64 fail\n"))
  (if (> 3.14 3.0)
    (print "f32 ok\n")
    (print "f32 fail\n"))
  (if (< -1.5 0.0)
    (print "f32 val: -1.5\n")
    (print "f32 val: fail\n"))
  (if (> 3.14f64 3.0f64)
    (print "f64 ok\n")
    (print "f64 fail\n"))
  (if (= 0xFF 255)
    (print "hex ok\n")
    (print "hex fail\n"))
  (if (= 0xFFi64 255i64)
    (print "hex64 ok\n")
    (print "hex64 fail\n"))
  (print "string ok\n"))
