{
  "name": "woua",
  "displayName": "woua",
  "description": "Syntax highlighting and diagnostics for the woua language",
  "version": "0.1.0",
  "publisher": "woua",
  "repository": { "type": "git", "url": "https://github.com/woua/woua" },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:woua"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "woua",
        "aliases": [
          "woua",
          "Woua"
        ],
        "extensions": [
          ".woua"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "woua",
        "scopeName": "source.woua",
        "path": "./syntaxes/woua.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "woua",
      "properties": {
        "woua.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to wouac.wasm. Leave empty to auto-detect from the workspace (wouac/dist/wouac.wasm)."
        },
        "woua.wasmtimePath": {
          "type": "string",
          "default": "wasmtime",
          "description": "Path to the wasmtime executable."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0",
    "vsce": "1.103.1"
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  }
}
