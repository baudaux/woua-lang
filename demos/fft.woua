(include io)
(include math)
(include simd)
(include svg)

(defconst 2_PI 6.283185307)

(defconst FREQ 44100.0)
(defconst N 4096)
(defconst NSAMPLES (* 10 N))

(defconst f1 50.0)
(defconst f2 120.0)
(defconst LOG_N 12)  ;; log2(N) = log2(4096)

(defconst CHART-BINS 128)  ;; number of FFT bins to display (0..127)

(defn dump (a :f32[]) :void
    (for n 0 (alen a)
        (printf "%d: %f\n" n a[n])))

(defn comp-input (fs :f32 len :i32) :f32[]
    (let a :f32[len]
        (for n 0 len
            (let t :f32 (/ (as :f32 n) fs)
                (aset! a n (+ (sin (* 2_PI (* f1 t))) (* 0.5 (sin (* 2_PI (* f2 t))))))))
        a))

;; for (int n = 0; n < N; n++) {
;;    window[n] = 0.5 * (1 - cos(2 * PI * n / (N - 1)));
;; }

(defn comp-win (fs :f32 len :i32) :f32[]
    (let a :f32[len]
        (for n 0 len
            (aset! a n (* 0.5 (- 1.0 (cos (/ (* 2_PI (as :f32 n)) (as :f32 (- len 1))))))))
        a))

(defn hanning (in :f32[] win :f32[] offset :i32) :f32[]
    (let a :f32[N]
        (let* ((i :i32 0))
            (while (< i N)
                (f32x4-store (+ (slice/ptr a) (* i 4))
                    (* (f32x4-load (+ (slice/ptr in) (* (+ i offset) 4)))
                       (f32x4-load (+ (slice/ptr win) (* i 4)))))
                (set! i (+ i 4))))
        a))

;; Single butterfly: (ar+wr*br-wi*bi, ai+wr*bi+wi*br) and conjugate.
(defn butterfly (srcRe :f32[] srcIm :f32[] dstRe :f32[] dstIm :f32[]
                 i0 :i32 i1 :i32 wr :f32 wi :f32) :void
    (let* ((ar :f32 srcRe[i0])
           (ai :f32 srcIm[i0])
           (br :f32 srcRe[i1])
           (bi :f32 srcIm[i1])
           (tr :f32 (- (* wr br) (* wi bi)))
           (ti :f32 (+ (* wr bi) (* wi br))))
        (aset! dstRe i0 (+ ar tr))
        (aset! dstIm i0 (+ ai ti))
        (aset! dstRe i1 (- ar tr))
        (aset! dstIm i1 (- ai ti))))

;; One Stockham pass for stage s.  m=2^s, step=2m.
(defn stockham-stage (srcRe :f32[] srcIm :f32[] dstRe :f32[] dstIm :f32[] s :i32) :void
    (let* ((m    :i32 (<< 1 s))
           (step :i32 (<< m 1))
           (k    :i32 0))
        (while (< k m)
            (let* ((angle :f32 (/ (* (neg 2_PI) (as :f32 k)) (as :f32 step)))
                   (wr    :f32 (cos angle))
                   (wi    :f32 (sin angle))
                   (g     :i32 0))
                (while (< g (/ N step))
                    (butterfly srcRe srcIm dstRe dstIm
                        (+ (* g step) k)
                        (+ (* g step) (+ k m))
                        wr wi)
                    (set! g (+ g 1))))
            (set! k (+ k 1)))))

;; Stockham FFT: LOG_N stages, ping-pong A↔B, result in reA/imgA (LOG_N even).
(defn stockham-fft (reA :f32[] reB :f32[] imgA :f32[] imgB :f32[]) :void
    (for s 0 LOG_N
        (if (= (% s 2) 0)
            (stockham-stage reA imgA reB imgB s)
            (stockham-stage reB imgB reA imgA s))))

;; Render the FFT magnitude spectrum into the browser SVG canvas.
;; Only the first CHART-BINS bins are drawn (the meaningful low-freq range).
(defn draw-spectrum (reA :f32[] imgA :f32[]) :void
    ;; Pass 1 — find peak magnitude across bins 1..CHART-BINS-1 (skip DC)
    (let* ((max-mag :f32 1.0)
           (mi      :i32 1))
        (while (< mi CHART-BINS)
            (let* ((re  :f32 reA[mi])
                   (im  :f32 imgA[mi])
                   (mag :f32 (sqrt (+ (* re re) (* im im)))))
                (if (> mag max-mag) (set! max-mag mag)))
            (set! mi (+ mi 1)))
        ;; Pass 2 — open SVG device and draw
        (let* ((svg-fd :i32    (open-file "/dev/svg" 0))
               (buf    :*SvgBuf (svg-buf-new 32768)))
                    (svg-root-attr buf "width"   "1380")
                    (svg-root-attr buf "height"  "430")
                    (svg-root-attr buf "viewBox" "0 0 1380 430")
                    (svg-rect buf "bg" 0 0 1380 430 "#0f0f23")
                    (svg-text buf "ttl" 20 28 "#e0e0e0"
                        "FFT spectrum: 50 Hz + 0.5x120 Hz  (N=4096, fs=44100 Hz)")
                    (svg-line buf "ax" 50 380 1330 380 "#666666")
                    ;; Frequency grid lines and Hz labels every 16 bins
                    (let li :i32 0
                        (while (<= li CHART-BINS)
                            (let* ((lx  :i32 (+ 50 (as :i32 (* (as :f32 li) (/ 1280.0 (as :f32 CHART-BINS))))))
                                   (fhz :i32 (as :i32 (* (as :f32 li) (/ FREQ (as :f32 N))))))
                                (svg-line buf (string-concat "g" (i32->str li)) lx 50 lx 380 "#1a1a3e")
                                (svg-line buf (string-concat "t" (i32->str li)) lx 380 lx 388 "#888888")
                                (svg-text buf (string-concat "l" (i32->str li)) (- lx 16) 410 "#aaaaaa"
                                    (string-concat (i32->str fhz) " Hz")))
                            (set! li (+ li 16))))
                    ;; Magnitude bars for bins 0..CHART-BINS-1
                    (let i :i32 0
                        (while (< i CHART-BINS)
                            (let* ((re  :f32 reA[i])
                                   (im  :f32 imgA[i])
                                   (mag :f32 (sqrt (+ (* re re) (* im im))))
                                   (bh  :f32 (* (/ mag max-mag) 320.0))
                                   (bw  :f32 (/ 1280.0 (as :f32 CHART-BINS)))
                                   (x   :f32 (+ 50.0 (* (as :f32 i) bw)))
                                   (y   :f32 (- 380.0 bh)))
                                (svg-rect-f buf (i32->str (+ i 100)) x y (- bw 1.0) bh "#4fc3f7"))
                            (set! i (+ i 1))))
                    (svg-flush-to buf svg-fd))))
(defn main ()
    (let* ((in   :f32[] (comp-input FREQ NSAMPLES))
           (win  :f32[] (comp-win FREQ N))
           (reA  :f32[] (hanning in win 0))
           (imgA :f32[N])
           (reB  :f32[N])
           (imgB :f32[N]))
        (stockham-fft reA reB imgA imgB)
        (draw-spectrum reA imgA)))
