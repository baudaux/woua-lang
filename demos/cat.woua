;; Demo: cat — open and print a file passed as a command-line argument.
;;
;; Usage (from repo root):
;;   wasmtime --dir=/tmp demos/out/cat.wasm /tmp/test.txt
;;
;; WASI requires a preopened directory to be granted at launch (--dir=<path>).
;; open-file calls resolve-path internally to split the preopen prefix from the
;; relative sub-path, then calls path_open to get a readable fd.

(include io)
(include string)

(defn main ()
  (if (< (args-count) 2)
    (progn
      (printf "usage: cat <path>\n")
      (proc_exit 1))
    (let* ((path-arg :str   (args-get 1))
           (fd       :i32   (open-file path-arg 1)))
      (if (< fd 0)
        (progn
          (printf "error: could not open %s\n" path-arg)
          (proc_exit 1))
        (let* ((buf       :ptr    (alloc 512))
               (iov       :*Iovec (alloc (+ (sizeof Iovec) 4)))
               (nread_ptr :i32    (+ (as :i32 iov) (sizeof Iovec))))
          (Iovec/len! iov 512)
          (Iovec/base! iov buf)
          (let stop :i32 0
            (while (= stop 0)
              (drop (fd_read fd (as :i32 iov) 1 nread_ptr))
              (let nr :i32 (i32.load nread_ptr)
                (if (= nr 0)
                  (set! stop 1)
                  (write STDOUT buf nr)))))
          (close-file fd))))))