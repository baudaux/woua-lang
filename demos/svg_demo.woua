;; svg_demo.woua — SVG rendering demo using lib/svg.woua + js/svg-bridge.js
;;
;; This demo draws a small scene into the browser SVG canvas, then animates
;; a bouncing ball by updating only its cx/cy on each tick (using nanosleep).
;;
;; Browser setup:
;;   import { mountSvg } from '../js/svg-bridge.js';
;;   import { WASI } from '@wasmer/wasi';
;;
;;   const wasi = new WASI({ ...options });
;;   const imports = { wasi_snapshot_preview1: wasi.wasiImport };
;;   const bridge = mountSvg(imports, '#canvas', 400, 300, '0 0 400 300');
;;   const { instance } = await WebAssembly.instantiateStreaming(fetch('svg_demo.wasm'), imports);
;;   bridge.connectInstance(instance);
;;   wasi.start(instance);

(include svg)

;; Canvas dimensions
(defconst CANVAS-W 400)
(defconst CANVAS-H 300)

;; Ball radius
(defconst BALL-R  18)

;; Frame delay (~33 ms ≈ 30 fps) expressed in nanoseconds for poll-sleep-ns
(defconst FRAME-NS 33000000)

(defn main ()
  (let svg-fd :i32 (open-file "/dev/svg" 0)
    (let buf :*SvgBuf (svg-buf-new 4096)

    ;; ── Root <svg> attributes ─────────────────────────────────────────────
    (svg-root-attr buf "width"   (i32->str CANVAS-W))
    (svg-root-attr buf "height"  (i32->str CANVAS-H))
    (svg-root-attr buf "viewBox" (string-concat "0 0 " (string-concat (i32->str CANVAS-W) (string-concat " " (i32->str CANVAS-H)))))

    ;; ── Static background ─────────────────────────────────────────────────

    ;; Sky background
    (svg-rect buf "bg" 0 0 CANVAS-W CANVAS-H "#87CEEB")

    ;; Ground strip
    (svg-rect buf "ground" 0 240 CANVAS-W 60 "#228B22")

    ;; Sun
    (svg-circle buf "sun" 340 50 30 "#FFD700")

    ;; A tree trunk
    (svg-rect buf "trunk" 80 180 16 60 "#8B4513")

    ;; Tree canopy
    (svg-circle buf "canopy" 88 165 36 "#006400")

    ;; Title text
    (svg-text buf "title" 120 30 "#003366" "woua SVG demo")

    ;; ── Bouncing ball ─────────────────────────────────────────────────────

    ;; Draw ball at initial position — flush the complete static scene
    (svg-circle buf "ball" 50 220 BALL-R "#FF4500")
    (svg-flush-to buf svg-fd)

    ;; Animation loop: bounce the ball horizontally and vertically (infinite)
    (let bx    :i32 50
      (let by    :i32 220
        (let dx    :i32 4
          (let dy    :i32 -3
            (while 1

                ;; Passive sleep for one frame duration
                (poll-sleep-ns (as :i64 FRAME-NS))

                ;; Update position
                (set! bx (+ bx dx))
                (set! by (+ by dy))

                ;; Bounce off walls
                (if (>= bx (- CANVAS-W BALL-R))
                  (let _d :i32 0
                    (set! bx (- CANVAS-W BALL-R))
                    (set! dx (- 0 dx))))
                (if (< bx BALL-R)
                  (let _d :i32 0
                    (set! bx BALL-R)
                    (set! dx (- 0 dx))))

                ;; Bounce off ground and ceiling
                (if (>= by (- 240 BALL-R))
                  (let _d :i32 0
                    (set! by (- 240 BALL-R))
                    (set! dy (- 0 dy))))
                (if (< by BALL-R)
                  (let _d :i32 0
                    (set! by BALL-R)
                    (set! dy (- 0 dy))))

                ;; Re-emit the ball with updated position (upsert by id)
                (svg-circle buf "ball" bx by BALL-R "#FF4500")
                (svg-flush-to buf svg-fd)))))))))
