;; Standard I/O helpers — includes wasi_p1.woua for the full WASI p1 surface.
;;   (include "std_io.woua")

(include wasi_p1)
(include string)

;; Standard file descriptors
(defconst STDIN  0)
(defconst STDOUT 1)
(defconst STDERR 2)

;; Iovec: WASI scatter/gather I/O vector (wasi_ciovec_t layout).
;; An extra 4-byte nwritten slot sits immediately after the struct in __iov.
(deftype Iovec
  (base :ptr)
  (len  :i32))

;; Static scratch buffers shared by write, print-char, read-line, pread,
;; pwrite, sock-recv, sock-send — allocated once in the static data section.
;;
;; TODO: for multi-threaded use these would need per-thread buffers; a single
;;       static set is safe for single-threaded programs.
(defstatic __iov        :bytes 12)  ;; Iovec (8 bytes) + 4-byte nwritten/nread slot
(defstatic __pc-byte    :bytes 1)   ;; single-byte scratch for print-char / assert newline
(defstatic __fd-out     :i32)       ;; 4-byte scratch for fd-returning syscalls
(defstatic __ro-flags   :i32)       ;; 4-byte scratch for sock_recv ri_flags_out
(defstatic __prestat    :bytes 8)   ;; 8-byte wasi_prestat_t scratch
(defstatic __scratch-256  :bytes 256) ;; path scratch shared by open/create/remove/stat
(defstatic __scratch-512  :bytes 512) ;; path scratch for rename-file (two 256-byte halves)
(defstatic __filestat     :bytes 64)  ;; wasi_filestat_t scratch for file-size
(defstatic __poll2-subs   :bytes 96)  ;; 2 × 48-byte subscriptions for poll-fd-read/write
(defstatic __poll2-evts   :bytes 64)  ;; 2 × 32-byte events
(defstatic __poll2-nevt   :i32)       ;; event count output
(defstatic __args-argc-s  :i32)       ;; 4-byte scratch for args_sizes_get
(defstatic __args-bufsz-s :i32)       ;; 4-byte scratch for args_sizes_get

;; write is a macro: uses the static __iov scratch (no heap allocation).
(defmacro write (fd ptr len)
  (let __write_iov :*Iovec (static-ptr __iov)
    (Iovec/base! __write_iov ptr)
    (Iovec/len!  __write_iov len)
    (drop (fd_write fd (as :i32 __write_iov) 1 (+ (as :i32 __write_iov) (sizeof Iovec))))))

;; write-string: like write but takes a runtime str struct instead of
;; compile-time static-ptr/static-len.
(defmacro write-string (fd s)
  (write fd (str/ptr s) (str/len s)))

;; print-string: print a runtime str struct to stdout.
(defmacro print-string (s)
  (write-string 1 s))

;; print-int: convert an i32 to str and print it to stdout.
(defmacro print-int (n)
  (print-string (i32->str n)))

;; print-int64: convert an i64 to str and print it to stdout.
(defmacro print-int64 (n)
  (print-string (i64->str n)))

;; print-float: convert an f32 to str and print it to stdout.
(defmacro print-float (f)
  (print-string (f32->str f)))

;; print-float64: convert an f64 to str and print it to stdout.
(defmacro print-float64 (f)
  (print-string (f64->str f)))

;; print-char: print a single byte value as a character to stdout.
(defmacro print-char (c)
  (let __pc_buf :ptr (static-ptr __pc-byte)
    (i32.store8 __pc_buf c)
    (write 1 __pc_buf 1)))

;; print is a macro: (print sym) expands to (write 1 ptr len)
;; where ptr and len are resolved at compile time from the static table.
(defmacro print (sym)
  (write 1 (static-ptr sym) (static-len sym)))

;; assert: if cond is false (0), write msg to stderr and exit with code 1.
;; (assert cond "message")
(defmacro assert (cond msg)
  (if (not cond)
    (let __assert_nl :ptr (static-ptr __pc-byte)
      (i32.store8 __assert_nl 10)
      (write 2 (static-ptr "assertion failed: ") (static-len "assertion failed: "))
      (write 2 (static-ptr msg) (static-len msg))
      (write 2 __assert_nl 1)
      (proc_exit 1))))

;; ── printf ───────────────────────────────────────────────────────────────────
;; (printf "format" args...)  — compile-time format string expansion.
;; The format string must be a string literal. Supported specifiers:
;;   %d / %i    → print-int   (i32)
;;   %ld / %li  → print-int64 (i64)
;;   %s         → print-string (str)
;;   %c         → print-char  (byte as i32)
;;   %%         → literal %
;;
;; printf-impl is the recursive worker:
;;   fmt  = string literal (interned to __str:... at macro-call time)
;;   pos  = current scan position (compile-time integer)
;;   alist = remaining runtime arguments (compile-time MacroListNode)
(defmacro printf-impl (fmt pos alist)
  (macro-if (>= pos (string-length fmt))
    0
    (macro-if (= (string-byte-at fmt pos) 37)
      ;; '%' at pos — dispatch on the next character
      (macro-if (= (string-byte-at fmt (+ pos 1)) 100)
        (macro-seq (print-int    (macro-first alist)) (printf-impl fmt (+ pos 2) (macro-rest alist)))
        (macro-if (= (string-byte-at fmt (+ pos 1)) 105)
          (macro-seq (print-int    (macro-first alist)) (printf-impl fmt (+ pos 2) (macro-rest alist)))
          (macro-if (= (string-byte-at fmt (+ pos 1)) 115)
            (macro-seq (print-string (macro-first alist)) (printf-impl fmt (+ pos 2) (macro-rest alist)))
            (macro-if (= (string-byte-at fmt (+ pos 1)) 99)
              (macro-seq (print-char   (macro-first alist)) (printf-impl fmt (+ pos 2) (macro-rest alist)))
              (macro-if (= (string-byte-at fmt (+ pos 1)) 108)
                ;; '%l...' — distinguish %lf (f64) from %ld/%li (i64)
                (macro-if (= (string-byte-at fmt (+ pos 2)) 102)
                  ;; '%lf' → print-float64 (f64), advance 3
                  (macro-seq (print-float64 (macro-first alist)) (printf-impl fmt (+ pos 3) (macro-rest alist)))
                  ;; '%ld', '%li', etc. → print-int64 (i64), advance 3
                  (macro-seq (print-int64   (macro-first alist)) (printf-impl fmt (+ pos 3) (macro-rest alist))))
                (macro-if (= (string-byte-at fmt (+ pos 1)) 102)
                  ;; '%f' → print-float (f32), advance 2
                  (macro-seq (print-float   (macro-first alist)) (printf-impl fmt (+ pos 2) (macro-rest alist)))
                  ;; '%%' or unknown → print '%', advance 2, do not consume arg
                  (macro-seq (print-char 37) (printf-impl fmt (+ pos 2) alist))))))))
      ;; Regular character at pos — print it and advance
      (macro-seq
        (print-char (string-byte-at fmt pos))
        (printf-impl fmt (+ pos 1) alist)))))

(defmacro printf (fmt ...args)
  (drop (printf-impl fmt 0 args)))

;; read-line: read one line from fd into buf (up to maxlen bytes), byte by byte.
;; Strips the trailing newline. Returns a str pointing into buf,
;; or a zero-length str on EOF.
(defn read-line (fd buf maxlen) :str
  (let iov      :*Iovec (static-ptr __iov)
    (let nread_ptr :i32 (+ (as :i32 iov) (sizeof Iovec))
      (Iovec/len! iov 1)
      (let len  :i32 0
        (let stop :i32 0
          (while (= stop 0)
            (Iovec/base! iov (+ buf len))
            (drop (fd_read fd (as :i32 iov) 1 nread_ptr))
            (if (= (i32.load nread_ptr) 0)
              (set! stop 1)
              (if (= (i32.load8_u (+ buf len)) 10)
                (set! stop 1)
                (set! len (+ len 1)))))
          (values buf len))))))

;; ── Command-line arguments ────────────────────────────────────────────────────

;; Internal cache: populated once on first use (0 = not yet loaded).
(defstatic __args_argc :i32)
(defstatic __args_argv :ptr)
(defstatic __args_buf  :ptr)

;; Load args from WASI once and store into the static cache.
(defn __args-init ()
  (if (= (i32.load (static-ptr __args_argv)) 0)
    (let argc_slot :ptr (static-ptr __args-argc-s)
      (let buf_slot  :ptr (static-ptr __args-bufsz-s)
        (drop (args_sizes_get argc_slot buf_slot))
        (let argc   :i32 (i32.load argc_slot)
          (let buf_sz :i32 (i32.load buf_slot)
            (let argv :ptr (alloc (* argc 4))
              (let buf  :ptr (alloc buf_sz)
                (drop (args_get argv buf))
                (i32.store (static-ptr __args_argc) argc)
                (i32.store (static-ptr __args_argv) argv)
                (i32.store (static-ptr __args_buf)  buf)))))))))

;; (args-count) → i32
;; Returns the number of command-line arguments (including argv[0]).
(defn args-count ()
  (__args-init)
  (i32.load (static-ptr __args_argc)))

;; (args-get i) → str
;; Returns the i-th command-line argument as a str.
(defn args-get (i :i32) :str
  (__args-init)
  (let argv :ptr (i32.load (static-ptr __args_argv))
    (let p :ptr (i32.load (+ argv (* i 4)))
      (let n :i32 0
        (while (i32.load8_u (+ p n))
          (set! n (+ n 1)))
        (values p n)))))

;; ── Preopened directories ─────────────────────────────────────────────────────
;; WASI sandboxes filesystem access via preopened directory fds.
;; Preopens are assigned fds starting at 3 (after stdin/stdout/stderr).
;; fd_prestat_get returns EBADF (8) when fd has no preopen — end of scan.
;;
;; (find-preopen name buf buf-len) → fd (i32, -1 if not found)
;; Low-level helper: finds the preopen fd whose name equals name exactly.
;; Kept for callers that have already split dir/path themselves.
(defn find-preopen (name :str buf :ptr buf-len :i32)
  (let name-ptr :ptr (str/ptr name)
    (let name-len :i32 (str/len name)
      (let prestat :ptr (static-ptr __prestat)
        (let fd     :i32 3
          (let result :i32 -1
            (let stop   :i32 0
              (while (= stop 0)
                (let errno :i32 (fd_prestat_get fd prestat)
                  (if (= errno 0)
                    (let dir-len :i32 (i32.load (+ prestat 4))
                      (if (<= dir-len buf-len)
                        (progn
                          (drop (fd_prestat_dir_name fd buf dir-len))
                          (if (= dir-len name-len)
                            (let i    :i32 0
                              (let match :i32 1
                                (while (< i dir-len)
                                  (if (= (i32.load8_u (+ buf i))
                                         (i32.load8_u (+ name-ptr i)))
                                    (set! i (+ i 1))
                                    (progn
                                      (set! match 0)
                                      (set! i dir-len))))
                                (if match
                                  (progn
                                    (set! result fd)
                                    (set! stop 1))
                                  (set! fd (+ fd 1)))))
                            (set! fd (+ fd 1))))
                        (set! fd (+ fd 1))))
                    (set! stop 1))))
              result)))))))

;; ResolvedPath — result of resolve-path.
;; fd:   the matching preopen fd, or -1 if no preopen covers path.
;; rptr: pointer into the original string at the start of the relative sub-path.
;; rlen: byte length of the relative sub-path.
(deftype ResolvedPath
  (fd   :i32)
  (rptr :ptr)
  (rlen :i32))

;; (resolve-path path scratch scratch-len) → :*ResolvedPath
;; Split a full path into a WASI preopen fd and the relative sub-path.
;; Matching rules (first matching preopen wins):
;;   preopen is "."              → rel = path entirely
;;   path starts with "PNAME/"   → rel = path after the slash
;;   path == "PNAME"             → rel = "." (written into scratch)
;; If no preopen matches, fd = -1 and rel = path (pass-through).
;; scratch must be at least as large as the longest preopen name (256 bytes safe).
(defn resolve-path (path :str scratch :ptr scratch-len :i32) :*ResolvedPath
  (let path-ptr :ptr (str/ptr path)
    (let path-len :i32 (str/len path)
      (let prestat :ptr (static-ptr __prestat)
        (let res :*ResolvedPath (alloc (sizeof ResolvedPath))
          (ResolvedPath/fd!   res -1)
          (ResolvedPath/rptr! res path-ptr)
          (ResolvedPath/rlen! res path-len)
          (let fd   :i32 3
            (let stop :i32 0
              (while (= stop 0)
                (let errno :i32 (fd_prestat_get fd prestat)
                  (if (= errno 0)
                    (let name-len :i32 (i32.load (+ prestat 4))
                      (if (<= name-len scratch-len)
                        (progn
                          (drop (fd_prestat_dir_name fd scratch name-len))
                          (if (& (= name-len 1) (= (i32.load8_u scratch) 46))
                            ;; preopen is "." — matches everything; lowest priority
                            ;; only use it if nothing better was found yet
                            (if (= (ResolvedPath/fd res) -1)
                              (progn
                                (ResolvedPath/fd!   res fd)
                                (ResolvedPath/rptr! res path-ptr)
                                (ResolvedPath/rlen! res path-len)
                                (set! fd (+ fd 1)))
                              (set! fd (+ fd 1)))
                            ;; compare bytes of preopen name against path prefix
                            (if (& (>= path-len (+ name-len 1))
                                     (= (i32.load8_u (+ path-ptr name-len)) 47))
                              ;; path starts with "name/" — check each byte
                              (let i     :i32 0
                                (let match :i32 1
                                  (while (< i name-len)
                                    (if (= (i32.load8_u (+ path-ptr i))
                                           (i32.load8_u (+ scratch i)))
                                      (set! i (+ i 1))
                                      (progn (set! match 0) (set! i name-len))))
                                  (if match
                                    (progn
                                      (ResolvedPath/fd!   res fd)
                                      (ResolvedPath/rptr! res (+ path-ptr (+ name-len 1)))
                                      (ResolvedPath/rlen! res (- path-len (+ name-len 1)))
                                      (set! stop 1))
                                    (set! fd (+ fd 1)))))
                              ;; check if path == preopen name exactly
                              (if (= path-len name-len)
                                (let i     :i32 0
                                  (let match :i32 1
                                    (while (< i name-len)
                                      (if (= (i32.load8_u (+ path-ptr i))
                                             (i32.load8_u (+ scratch i)))
                                        (set! i (+ i 1))
                                        (progn (set! match 0) (set! i name-len))))
                                    (if match
                                      (progn
                                        ;; relative path is "." — write into scratch
                                        (i32.store8 scratch 46)
                                        (ResolvedPath/fd!   res fd)
                                        (ResolvedPath/rptr! res scratch)
                                        (ResolvedPath/rlen! res 1)
                                        (set! stop 1))
                                      (set! fd (+ fd 1)))))
                                (set! fd (+ fd 1))))))
                        (set! fd (+ fd 1))))
                    (set! stop 1)))))
          res))))))

;; (open-file-at dirfd path readonly) → fd (i32, negative = errno)
;; Low-level: open path relative to an already-known preopen dirfd.
;;   readonly = 1 → rights: FD_READ | FD_SEEK | FD_TELL  (2|4|32 = 38)
;;   readonly = 0 → above + FD_DATASYNC | FD_SYNC | FD_WRITE (1|16|64 = 81, total 119)
(defn open-file-at (dirfd :i32 path :str readonly :i32)
  (let fd-out :ptr (static-ptr __fd-out)
    (let rights :i64 (if readonly 38i64 119i64)
      (let err :i32 (path_open dirfd 1 (str/ptr path) (str/len path) 0 rights rights 0 fd-out)
        (if (= err 0)
          (i32.load fd-out)
          (* -1 err))))))

;; (open-file path readonly) → fd (i32, negative on error)
;; Open path, splitting off the preopen prefix automatically.
;; e.g. (open-file "tmp/data.txt" 1) opens "data.txt" relative to the "tmp" preopen.
(defn open-file (path :str readonly :i32)
  (let scratch :ptr (static-ptr __scratch-256)
    (let r :*ResolvedPath (resolve-path path scratch 256)
      (if (= (ResolvedPath/fd r) -1)
        -1
        (let rel :str (values (ResolvedPath/rptr r) (ResolvedPath/rlen r))
          (open-file-at (ResolvedPath/fd r) rel readonly))))))

;; (create-file-at dirfd path) → fd (i32, negative = errno)
;; Low-level: create/truncate path relative to an already-known preopen dirfd.
(defn create-file-at (dirfd :i32 path :str)
  (let fd-out :ptr (static-ptr __fd-out)
    (let err :i32 (path_open dirfd 1 (str/ptr path) (str/len path) 9 119i64 119i64 0 fd-out)
      (if (= err 0)
        (i32.load fd-out)
        (* -1 err)))))

;; (create-file path) → fd (i32, negative on error)
;; Create or truncate path, splitting off the preopen prefix automatically.
(defn create-file (path :str)
  (let scratch :ptr (static-ptr __scratch-256)
    (let r :*ResolvedPath (resolve-path path scratch 256)
      (if (= (ResolvedPath/fd r) -1)
        -1
        (let rel :str (values (ResolvedPath/rptr r) (ResolvedPath/rlen r))
          (create-file-at (ResolvedPath/fd r) rel))))))

;; (close-file fd) — close a file descriptor; discards the errno return value.
(defmacro close-file (fd)
  (drop (fd_close fd)))

;; (file-size fd) → :i64 — return the byte size of an open file.
;; Allocates a 64-byte filestat buffer, calls fd_filestat_get, and reads the
;; size field (a u64) at byte offset 32.
(defn file-size (fd :i32) :i64
  (let stat :ptr (static-ptr __filestat)
    (drop (fd_filestat_get fd stat))
    (i64.load (+ stat 32))))

;; (pread fd buf len offset) → :i32
;; Read up to len bytes from fd at absolute byte offset into buf.
;; Returns the number of bytes actually read.
(defn pread (fd :i32 buf :ptr len :i32 offset :i64) :i32
  (let iov   :*Iovec (static-ptr __iov)
    (let nread :ptr (+ (as :i32 iov) (sizeof Iovec))
      (Iovec/base! iov buf)
      (Iovec/len!  iov len)
      (drop (fd_pread fd (as :i32 iov) 1 offset nread))
      (i32.load nread))))

;; (pwrite fd buf len offset) → :i32
;; Write len bytes from buf to fd at absolute byte offset.
;; Returns the number of bytes actually written.
(defn pwrite (fd :i32 buf :ptr len :i32 offset :i64) :i32
  (let iov      :*Iovec (static-ptr __iov)
    (let nwritten :ptr (+ (as :i32 iov) (sizeof Iovec))
      (Iovec/base! iov buf)
      (Iovec/len!  iov len)
      (drop (fd_pwrite fd (as :i32 iov) 1 offset nwritten))
      (i32.load nwritten))))

;; (remove-file path) → :i32  (0 = ok, non-zero = WASI errno)
;; Delete path, splitting off the preopen prefix automatically.
(defn remove-file (path :str) :i32
  (let scratch :ptr (static-ptr __scratch-256)
    (let r :*ResolvedPath (resolve-path path scratch 256)
      (if (= (ResolvedPath/fd r) -1)
        8
        (path_unlink_file (ResolvedPath/fd r)
                          (ResolvedPath/rptr r)
                          (ResolvedPath/rlen r))))))

;; (make-dir path) → :i32  (0 = ok, non-zero = WASI errno)
;; Create directory at path, splitting off the preopen prefix automatically.
(defn make-dir (path :str) :i32
  (let scratch :ptr (static-ptr __scratch-256)
    (let r :*ResolvedPath (resolve-path path scratch 256)
      (if (= (ResolvedPath/fd r) -1)
        8
        (path_create_directory (ResolvedPath/fd r)
                               (ResolvedPath/rptr r)
                               (ResolvedPath/rlen r))))))

;; (remove-dir path) → :i32  (0 = ok, non-zero = WASI errno)
;; Remove empty directory at path, splitting off the preopen prefix automatically.
(defn remove-dir (path :str) :i32
  (let scratch :ptr (static-ptr __scratch-256)
    (let r :*ResolvedPath (resolve-path path scratch 256)
      (if (= (ResolvedPath/fd r) -1)
        8
        (path_remove_directory (ResolvedPath/fd r)
                               (ResolvedPath/rptr r)
                               (ResolvedPath/rlen r))))))

;; (rename-file src dst) → :i32  (0 = ok, non-zero = WASI errno)
;; Rename src to dst, resolving each path's preopen independently.
(defn rename-file (src :str dst :str) :i32
  (let scratch :ptr (static-ptr __scratch-512)
    (let rs :*ResolvedPath (resolve-path src scratch 256)
      (let rd :*ResolvedPath (resolve-path dst (+ scratch 256) 256)
        (if (| (= (ResolvedPath/fd rs) -1) (= (ResolvedPath/fd rd) -1))
          8
          (path_rename (ResolvedPath/fd rs)
                       (ResolvedPath/rptr rs) (ResolvedPath/rlen rs)
                       (ResolvedPath/fd rd)
                       (ResolvedPath/rptr rd) (ResolvedPath/rlen rd)))))))

;; ── File stat ─────────────────────────────────────────────────────────────────
;; FileStat mirrors the 64-byte wasi_filestat_t layout:
;;   dev:u64 ino:u64 filetype:u8(+7 pad) nlink:u64 size:u64 atim:u64 mtim:u64 ctim:u64
;; filetype values: 0=unknown 1=block_device 2=char_device 3=directory
;;                  4=regular_file 5=socket_dgram 6=socket_stream 7=symlink
;; filetype is stored as :i64 to cover the u8 + 7 pad bytes; extract with (as :i32 ...).
(deftype FileStat
  (dev      :i64)   ;; offset  0 — device id
  (ino      :i64)   ;; offset  8 — inode number
  (filetype :i64)   ;; offset 16 — low byte is filetype u8; rest is zero padding
  (nlink    :i64)   ;; offset 24 — hard link count
  (size     :i64)   ;; offset 32 — file size in bytes
  (atim     :i64)   ;; offset 40 — last access time (nanoseconds)
  (mtim     :i64)   ;; offset 48 — last modification time (nanoseconds)
  (ctim     :i64))  ;; offset 56 — last status change time (nanoseconds)

;; (stat-fd fd) → :*FileStat
;; Allocate and fill a FileStat for an already-open file descriptor.
(defn stat-fd (fd :i32) :*FileStat
  (let buf :*FileStat (alloc 64)
    (drop (fd_filestat_get fd (as :i32 buf)))
    buf))

;; (stat-path path) → :*FileStat
;; Allocate and fill a FileStat by path, following symlinks.
;; Splits off the preopen prefix automatically.
;; Returns a zeroed struct if no preopen matches or the path does not exist.
(defn stat-path (path :str) :*FileStat
  (let scratch :ptr (alloc 256)
    (let r :*ResolvedPath (resolve-path path scratch 256)
      (let buf :*FileStat (alloc 64)
        (if (!= (ResolvedPath/fd r) -1)
          (drop (path_filestat_get (ResolvedPath/fd r) 1
                                   (ResolvedPath/rptr r) (ResolvedPath/rlen r)
                                   (as :i32 buf))))
        buf))))

;; ── Sockets ───────────────────────────────────────────────────────────────────
;; WASI Preview 1 only supports the server/accept side of connected sockets
;; (no bind/listen/connect — those require WASIX or the sockets proposal).
;; The four helpers below wrap the four available syscalls.

;; (sock-accept fd) → :i32
;; Accept the next incoming connection on listening fd.
;; Returns the new connection fd on success, or a negative WASI errno on failure.
(defn sock-accept (fd :i32) :i32
  (let conn-out :ptr (static-ptr __fd-out)
    (let err :i32 (sock_accept fd 0 conn-out)
      (if (= err 0)
        (i32.load conn-out)
        (* -1 err)))))

;; (sock-recv fd buf len) → :i32
;; Receive up to len bytes from a connected socket fd into buf.
;; Returns the number of bytes received, or a negative WASI errno on failure.
(defn sock-recv (fd :i32 buf :ptr len :i32) :i32
  (let iov      :*Iovec (static-ptr __iov)
    (let nread    :ptr (+ (as :i32 iov) (sizeof Iovec))
      (let ro-flags :ptr (static-ptr __ro-flags)
        (Iovec/base! iov buf)
        (Iovec/len!  iov len)
        (let err :i32 (sock_recv fd (as :i32 iov) 1 0 nread ro-flags)
          (if (= err 0)
            (i32.load nread)
            (* -1 err)))))))

;; (sock-send fd buf len) → :i32
;; Send len bytes from buf over connected socket fd.
;; Returns the number of bytes sent, or a negative WASI errno on failure.
(defn sock-send (fd :i32 buf :ptr len :i32) :i32
  (let iov       :*Iovec (static-ptr __iov)
    (let nwritten  :ptr (+ (as :i32 iov) (sizeof Iovec))
      (Iovec/base! iov buf)
      (Iovec/len!  iov len)
      (let err :i32 (sock_send fd (as :i32 iov) 1 0 nwritten)
        (if (= err 0)
          (i32.load nwritten)
          (* -1 err))))))

;; (sock-shutdown fd how) — shut down part of a socket connection.
;;   how: 0=read  1=write  2=read+write
(defmacro sock-shutdown (fd how)
  (drop (sock_shutdown fd how)))

;; ── poll_oneoff helpers ───────────────────────────────────────────────────────
;; poll_oneoff is the WASI equivalent of POSIX select/poll.
;;
;; Subscription struct layout (48 bytes each):
;;   offset  0 — userdata    u64  (echoed back in the event; use as a tag)
;;   offset  8 — tag         u8   0=clock  1=fd_read  2=fd_write
;;   offset  9 — padding     7 bytes
;;   offset 16 — union body  32 bytes
;;     clock  body: clock_id:u32(+4pad) timeout:u64 precision:u64 flags:u16(+6pad)
;;     fd_rw  body: fd:u32 followed by 28 bytes padding
;;
;; Event struct layout (32 bytes each):
;;   offset  0 — userdata    u64  (same value as subscription.userdata)
;;   offset  8 — error       u16  (0 = success)
;;   offset 10 — type        u8   (same tag values as subscription)
;;   offset 11 — padding     5 bytes
;;   offset 16 — nbytes      u64  (bytes available for fd events)
;;   offset 24 — flags       u16  (bit 0 = hangup)
;;   offset 26 — padding     6 bytes

;; (poll-fd-read fd timeout-ns) → :i32
;; Wait until fd is readable, or until timeout-ns nanoseconds have elapsed.
;; Returns 1 if fd is readable, 0 if timed out, or -errno on error.
;; Pass timeout-ns = -1i64 to wait forever (clock subscription omitted).
;;
;; Internally allocates two subscriptions (fd_read + clock) and one event slot.
(defn poll-fd-read (fd :i32 timeout-ns :i64) :i32
  ;; 2 subscriptions × 48 bytes = 96; 2 events × 32 bytes = 64
  (let subs  :ptr (static-ptr __poll2-subs)
    (let evts  :ptr (static-ptr __poll2-evts)
      (let nevt  :ptr (static-ptr __poll2-nevt)
        ;; subscription 0: fd_read
        (i64.store subs 0i64)                          ;; userdata = 0
        (i32.store8 (+ subs 8) 1)                      ;; tag = fd_read
        (i32.store  (+ subs 16) fd)                    ;; fd
        ;; subscription 1: clock timeout (only if timeout-ns >= 0)
        (let nsubs :i32
          (if (>= timeout-ns 0i64)
            (progn
              (i64.store  (+ subs 48) 1i64)            ;; userdata = 1
              (i32.store8 (+ subs 56) 0)               ;; tag = clock
              (i32.store  (+ subs 64) 1)               ;; clock_id = MONOTONIC
              (i64.store  (+ subs 72) timeout-ns)      ;; timeout
              (i64.store  (+ subs 80) 0i64)            ;; precision
              (i32.store  (+ subs 88) 0)               ;; flags (relative)
              2)
            1)
          (let err :i32 (poll_oneoff subs evts nsubs nevt)
            (if (!= err 0)
              (* -1 err)
              ;; scan events: return 1 if any fd_read event fired
              (let n   :i32 (i32.load nevt)
                (let i   :i32 0
                  (let res :i32 0
                    (while (< i n)
                      (let etype :i32 (i32.load8_u (+ evts (+ (* i 32) 10)))
                        (if (= etype 1)   ;; fd_read
                          (set! res 1)))
                      (set! i (+ i 1)))
                    res))))))))))

;; (poll-fd-write fd timeout-ns) → :i32
;; Wait until fd is writable, or until timeout-ns nanoseconds have elapsed.
;; Returns 1 if fd is writable, 0 if timed out, or -errno on error.
;; Pass timeout-ns = -1i64 to wait forever.
(defn poll-fd-write (fd :i32 timeout-ns :i64) :i32
  (let subs  :ptr (static-ptr __poll2-subs)
    (let evts  :ptr (static-ptr __poll2-evts)
      (let nevt  :ptr (static-ptr __poll2-nevt)
        (i64.store subs 0i64)
        (i32.store8 (+ subs 8) 2)                      ;; tag = fd_write
        (i32.store  (+ subs 16) fd)
        (let nsubs :i32
          (if (>= timeout-ns 0i64)
            (progn
              (i64.store  (+ subs 48) 1i64)
              (i32.store8 (+ subs 56) 0)
              (i32.store  (+ subs 64) 1)
              (i64.store  (+ subs 72) timeout-ns)
              (i64.store  (+ subs 80) 0i64)
              (i32.store  (+ subs 88) 0)
              2)
            1)
          (let err :i32 (poll_oneoff subs evts nsubs nevt)
            (if (!= err 0)
              (* -1 err)
              (let n   :i32 (i32.load nevt)
                (let i   :i32 0
                  (let res :i32 0
                    (while (< i n)
                      (let etype :i32 (i32.load8_u (+ evts (+ (* i 32) 10)))
                        (if (= etype 2)   ;; fd_write
                          (set! res 1)))
                      (set! i (+ i 1)))
                    res))))))))))

;; Static scratch buffers for poll-sleep-ns — allocated once in the static data
;; section to avoid growing the heap on every sleep call.
;;
;; TODO: for multi-threaded use these would need per-thread buffers; a single
;;       static set is safe for single-threaded programs.
(defstatic __poll-subs :bytes 48)
(defstatic __poll-evts :bytes 32)
(defstatic __poll-nevt :i32)

;; (poll-sleep-ns ns) — sleep for ns nanoseconds using a clock subscription.
(defn poll-sleep-ns (ns :i64) :void
  (let subs :ptr (static-ptr __poll-subs)
    (let evts :ptr (static-ptr __poll-evts)
      (let nevt :ptr (static-ptr __poll-nevt)
        (i64.store subs 0i64)
        (i32.store8 (+ subs 8) 0)         ;; tag = clock
        (i32.store  (+ subs 16) 1)        ;; clock_id = MONOTONIC
        (i64.store  (+ subs 24) ns)       ;; timeout
        (i64.store  (+ subs 32) 0i64)     ;; precision
        (i32.store  (+ subs 40) 0)        ;; flags = relative
        (drop (poll_oneoff subs evts 1 nevt))))))

;; PollSub event type constants (WASI eventtype values)
(defconst POLL-READ  1)  ;; fd_read  subscription
(defconst POLL-WRITE 2)  ;; fd_write subscription
(defconst POLL-CLOCK 0)  ;; clock (sleep) subscription

;; PollSub — one entry in the subscription table passed to poll-fds.
(deftype PollSub
  (fd   :i32)  ;; file descriptor to watch
  (type :i32)) ;; POLL-READ or POLL-WRITE

;; PollEvent — result slot parallel to the PollSub table.
;; After poll-fds returns, ready=1 means this subscription's fd fired.
(deftype PollEvent
  (ready  :i32)  ;; 1 = event fired, 0 = not fired / timed out
  (error  :i32)  ;; per-event WASI errno (0 = success)
  (nbytes :i64)) ;; bytes available (meaningful for fd_read events)

;; (poll-fds subs nsubs timeout-ns results) → :i32
;; Poll a table of (fd, type) subscriptions in one poll_oneoff call.
;;   subs       — pointer to nsubs PollSub structs  (caller allocates)
;;   nsubs      — number of fd subscriptions
;;   timeout-ns — nanoseconds until timeout; -1i64 to block forever
;;   results    — pointer to nsubs PollEvent structs (caller allocates)
;; Returns 0 on success, -errno on error.
;; On timeout all results remain ready=0; on error returns negative errno.
(defn poll-fds (subs :ptr nsubs :i32 timeout-ns :i64 results :ptr) :i32
  ;; WASI subscription buffer: (nsubs+1) × 48 bytes (+1 for optional clock)
  (let wsubs :ptr (alloc (* (+ nsubs 1) 48))
    (let wevts :ptr (alloc (* (+ nsubs 1) 32))
      (let nevt :ptr (alloc 4)
        ;; Body 1 of let nevt: zero the results array
        (let ri :i32 0
          (while (< ri nsubs)
            (let rbase :i32 (* ri (sizeof PollEvent))
              (i32.store (+ results rbase) 0)
              (i32.store (+ results (+ rbase 4)) 0)
              (i64.store (+ results (+ rbase 8)) 0i64))
            (set! ri (+ ri 1))))
        ;; Body 2 of let nevt: fill WASI subscriptions from the PollSub table
        (let si :i32 0
          (while (< si nsubs)
            (let wbase :i32 (* si 48)
              (let sbase :i32 (* si (sizeof PollSub))
                (i64.store  (+ wsubs wbase) (as :i64 si))         ;; userdata = index
                (i32.store8 (+ wsubs (+ wbase 8))
                            (i32.load (+ subs (+ sbase 4))))       ;; tag = type
                (i32.store  (+ wsubs (+ wbase 16))
                            (i32.load (+ subs sbase)))))           ;; fd
            (set! si (+ si 1))))
        ;; Body 3: add optional clock subscription, call poll_oneoff, scan events
        (let total :i32
          (if (>= timeout-ns 0i64)
            (let cbase :i32 (* nsubs 48)
              (i64.store  (+ wsubs cbase) (as :i64 nsubs))         ;; userdata = nsubs (sentinel)
              (i32.store8 (+ wsubs (+ cbase 8)) 0)                 ;; tag = clock
              (i32.store  (+ wsubs (+ cbase 16)) 1)                ;; clock_id = MONOTONIC
              (i64.store  (+ wsubs (+ cbase 24)) timeout-ns)       ;; timeout
              (i64.store  (+ wsubs (+ cbase 32)) 0i64)             ;; precision
              (i32.store  (+ wsubs (+ cbase 40)) 0)                ;; flags = relative
              (+ nsubs 1))
            nsubs)
          (let err :i32 (poll_oneoff wsubs wevts total nevt)
            (if (!= err 0)
              (* -1 err)
              ;; Scan returned events; use userdata as the PollSub slot index
              (let n :i32 (i32.load nevt)
                (let ei :i32 0
                  (while (< ei n)
                    (let ebase :i32 (* ei 32)
                      (let uidx :i32 (as :i32 (i64.load (+ wevts ebase)))
                        (if (< uidx nsubs)
                          (let rbase :i32 (* uidx (sizeof PollEvent))
                            (i32.store  (+ results rbase) 1)
                            (i32.store  (+ results (+ rbase 4))
                                        (i32.load16_u (+ wevts (+ ebase 8))))
                            (i64.store  (+ results (+ rbase 8))
                                        (i64.load (+ wevts (+ ebase 16))))))))
                    (set! ei (+ ei 1)))
                  0)))))))))
