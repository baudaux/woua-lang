;; str utility library — functions for comparing, slicing, copying,
;; concatenating, and searching strings.
;;
;; :str is a first-class fat-pointer type (ptr, len) built into the compiler.
;; String literals produce :str values automatically (no wrapper needed).
;; :*str is a pointer to a {base :ptr, len :i32} struct in linear memory
;; (allocated via defstatic or heap alloc). Field accessors str/ptr and str/len
;; transparently work on both :str locals and :*str memory pointers.
;;
;; Include:
;;   (include string)   ;; pulls in core.woua transitively

(include core)

;; ── In-memory str struct layout (:*str) ─────────────────────────────────────
;; Defines the field offsets for a str struct in linear memory.
;; str/ptr and str/len work on :*str pointers via i32.load / i32.load at +4.
(deftype str
  (ptr :ptr)
  (len :i32))

;; ── Accessors ────────────────────────────────────────────────────────────────

;; (string-len s) → i32  byte length of s
(defmacro string-len (s)
  (str/len s))

;; (string-ptr s) → ptr  raw data pointer of s
(defmacro string-ptr (s)
  (str/ptr s))

;; ── Comparison ───────────────────────────────────────────────────────────────

;; (string= a b) → i32
;; Returns 1 if a and b have identical content, 0 otherwise.
(defn string= (a :str b :str)
  (if (= (str/len a) (str/len b))
    (let n   :i32 (str/len a)
      (let pa  :i32 (str/ptr a)
        (let pb  :i32 (str/ptr b)
          (let i   :i32 0
            (let eq  :i32 1
              (while (< i n)
                (if (= (i32.load8_u (+ pa i)) (i32.load8_u (+ pb i)))
                  (set! i (+ i 1))
                  (let _d :i32 0
                    (set! eq 0)
                    (set! i n))))
              eq)))))
    0))

;; (string-eq s "literal") → i32
;; Compare a runtime str with a compile-time string literal.
(defmacro string-eq (s lit)
  (string= s lit))

;; ── Copying ──────────────────────────────────────────────────────────────────

;; (string-copy s) → str
;; Allocate a fresh buffer and copy s into it.
(defn string-copy (s :str) :str
  (let n   :i32 (str/len s)
    (let buf :ptr (alloc n)
      (let i  :i32 0
        (while (< i n)
          (i32.store8 (+ buf i) (i32.load8_u (+ (str/ptr s) i)))
          (set! i (+ i 1)))
        (values buf n)))))

;; ── Slicing ──────────────────────────────────────────────────────────────────

;; (string-slice s offset len) → str
;; Return a new str pointing into s's buffer at the given offset.
;; No data is copied. offset + len must not exceed (string-len s).
(defn string-slice (s :str offset len) :str
  (values (+ (str/ptr s) offset) len))

;; ── Concatenation ────────────────────────────────────────────────────────────

;; (string-concat a b) → str
;; Allocate a new buffer containing the bytes of a followed by the bytes of b.
(defn string-concat (a :str b :str) :str
  (let la  :i32 (str/len a)
    (let lb  :i32 (str/len b)
      (let buf :ptr (alloc (+ la lb))
        (let i  :i32 0
          (while (< i la)
            (i32.store8 (+ buf i) (i32.load8_u (+ (str/ptr a) i)))
            (set! i (+ i 1)))
          (set! i 0)
          (while (< i lb)
            (i32.store8 (+ buf (+ la i)) (i32.load8_u (+ (str/ptr b) i)))
            (set! i (+ i 1)))
          (values buf (+ la lb)))))))

;; ── Searching ────────────────────────────────────────────────────────────────

;; (string-index-of-byte s b) → i32
;; Return the index of the first occurrence of byte value b in s,
;; or -1 if not found.
(defn string-index-of-byte (s :str b)
  (let n     :i32 (str/len s)
    (let p     :i32 (str/ptr s)
      (let i     :i32 0
        (let found :i32 -1
          (while (< i n)
            (if (= (i32.load8_u (+ p i)) b)
              (let _d :i32 0
                (set! found i)
                (set! i n))
              (set! i (+ i 1))))
          found)))))

;; ── Number → str ─────────────────────────────────────────────────────────────

;; (i32-digits-buf n buf) → ptr
;; Writes the decimal ASCII digits of n into buf (12 bytes) right-to-left,
;; starting from buf+11 downward. Returns pointer to the first character.
;; Handles negative numbers by prepending '-'.
(defn i32-digits-buf (n buf)
  (let neg  :i32 (< n 0)
    (let negabs :i32 (if neg n (- 0 n))
      (let pos :i32 (+ buf 11)
        (while (< negabs -9)
          (i32.store8 pos (- 48 (- negabs (* (/ negabs 10) 10))))
          (set! pos    (- pos 1))
          (set! negabs (/ negabs 10)))
        (i32.store8 pos (- 48 negabs))
        (if neg
          (let _dummy :i32 0
            (set! pos (- pos 1))
            (i32.store8 pos 45)))
        pos))))

;; (i32->str n) → str
(defn i32->str (n) :str
  (let buf   :ptr (alloc 12)
    (let start :ptr (i32-digits-buf n buf)
      (values start (- (+ buf 12) start)))))

;; (i64-digits-buf n buf) → ptr
;; Like i32-digits-buf but for i64 values. buf must be at least 21 bytes.
(defn i64-digits-buf (n :i64 buf :ptr)
  (let neg    :i32 (< n 0i64)
    (let negabs :i64 (if neg n (- 0i64 n))
      (let pos :i32 (+ buf 20)
        (while (< negabs -9i64)
          (i32.store8 pos (- 48 (as :i32 (- negabs (* (/ negabs 10i64) 10i64)))))
          (set! pos    (- pos 1))
          (set! negabs (/ negabs 10i64)))
        (i32.store8 pos (- 48 (as :i32 negabs)))
        (if neg
          (let _dummy :i32 0
            (set! pos (- pos 1))
            (i32.store8 pos 45)))
        pos))))

;; (i64->str n) → str
(defn i64->str (n :i64) :str
  (let buf   :ptr (alloc 24)
    (let start :ptr (i64-digits-buf n buf)
      (values start (- (+ buf 21) start)))))

;; ── Float → str ──────────────────────────────────────────────────────────────

;; (f32->str f) → :str
;; Format f as a decimal string with 6 fractional digits, e.g. "3.141593".
;; Handles nan, +inf, -inf, and negative values.
;; The integer part is handled via i64, so values up to 2^63 are supported.
(defn f32->str (f :f32) :str
  (if (!= f f) "nan"
  (if (and (= f (/ f 2.0)) (!= f 0.0))
    (if (< f 0.0) "-inf" "inf")
    (let neg    :i32 (< f 0.0)
    (let fabs   :f64 (if neg (- 0.0f64 (as :f64 f)) (as :f64 f))
    (let ipart  :i64 (as :i64 fabs)
    (let ipf    :f64 (as :f64 ipart)
    (let frac6  :i32 (as :i32 (+ (* (- fabs ipf) 1000000.0f64) 0.5f64))
    (let carry  :i32 (/ frac6 1000000)
    (let ipart2 :i64 (+ ipart (as :i64 carry))
    (let frac6c :i32 (- frac6 (* carry 1000000))
    (let buf    :ptr (alloc 64)
    (let pos    :i32 0
    (let tmp    :ptr (alloc 24)
    (let istart :ptr (i64-digits-buf ipart2 tmp)
    (let ilen   :i32 (- (+ tmp 21) istart)
    (let i      :i32 0
      (if neg (let _d :i32 0 (i32.store8 buf 45) (set! pos 1)))
      (while (< i ilen)
        (i32.store8 (+ buf (+ pos i)) (i32.load8_u (+ istart i)))
        (set! i (+ i 1)))
      (set! pos (+ pos ilen))
      (i32.store8 (+ buf pos) 46)
      (set! pos (+ pos 1))
      (let fp :i32 (+ pos 5)
      (let fc :i32 frac6c
      (let fi :i32 0
        (while (< fi 6)
          (i32.store8 (+ buf (- fp fi)) (+ 48 (- fc (* (/ fc 10) 10))))
          (set! fc (/ fc 10))
          (set! fi (+ fi 1)))
        (values buf (+ pos 6))))))))))))))))))))))

;; (f64->str f) → :str
;; Format f as a decimal string with 6 fractional digits.
;; Like f32->str but operates entirely in f64 for greater precision.
(defn f64->str (f :f64) :str
  (if (!= f f) "nan"
  (if (and (= f (/ f 2.0f64)) (!= f 0.0f64))
    (if (< f 0.0f64) "-inf" "inf")
    (let neg    :i32 (< f 0.0f64)
    (let fabs   :f64 (if neg (- 0.0f64 f) f)
    (let ipart  :i64 (as :i64 fabs)
    (let ipf    :f64 (as :f64 ipart)
    (let frac6  :i32 (as :i32 (+ (* (- fabs ipf) 1000000.0f64) 0.5f64))
    (let carry  :i32 (/ frac6 1000000)
    (let ipart2 :i64 (+ ipart (as :i64 carry))
    (let frac6c :i32 (- frac6 (* carry 1000000))
    (let buf    :ptr (alloc 64)
    (let pos    :i32 0
    (let tmp    :ptr (alloc 24)
    (let istart :ptr (i64-digits-buf ipart2 tmp)
    (let ilen   :i32 (- (+ tmp 21) istart)
    (let i      :i32 0
      (if neg (let _d :i32 0 (i32.store8 buf 45) (set! pos 1)))
      (while (< i ilen)
        (i32.store8 (+ buf (+ pos i)) (i32.load8_u (+ istart i)))
        (set! i (+ i 1)))
      (set! pos (+ pos ilen))
      (i32.store8 (+ buf pos) 46)
      (set! pos (+ pos 1))
      (let fp :i32 (+ pos 5)
      (let fc :i32 frac6c
      (let fi :i32 0
        (while (< fi 6)
          (i32.store8 (+ buf (- fp fi)) (+ 48 (- fc (* (/ fc 10) 10))))
          (set! fc (/ fc 10))
          (set! fi (+ fi 1)))
        (values buf (+ pos 6))))))))))))))))))))))
