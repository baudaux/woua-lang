;; Core language operators and types — foundational declarations for woua.
;; (defop name "wat-op" (param-types...) result-type)
;; Same operator name can be declared multiple times for different types;
;; the compiler selects the right overload via type inference.

;; ── str ─────────────────────────────────────────────────────────────────────
;; :str is a first-class fat-pointer type (ptr :i32, len :i32) built into the
;; compiler. String literals "..." are interned into linear memory at compile
;; time and automatically produce a (ptr, len) two-value :str.
;; No heap allocation is needed for str headers.
;;
;; (static-ptr "s") and (static-len "s") still work as compile-time constants
;; when raw access to the pointer or length is needed.

;; ── Literal recognition ──────────────────────────────────────────────────────
;; (defliteral name "regex" :node-type)
;; Declares how the reader recognises a literal token.
;; The regex must have exactly one capture group containing the literal value.

;; A string literal: characters between double quotes, with escape sequences.
;; :static means matched values are interned into linear memory at compile time.
(defliteral string /"((?:[^"\\]|\\.)*)"/  :string :static)

;; A character literal: a single character between single quotes → i32 code point.
;; Supports the same escape sequences as string literals: \n \t \r \\ \' \0
;; Examples: 'A' → 65,  '\n' → 10,  '\'' → 39
(defliteral char /'.'/  :char)

;; Hexadecimal literals — prefix 0x, uppercase or lowercase digits.
;; Declared before int/int64 so the prefix check fires in the same read pass.
(defliteral hex64 /0x[0-9a-fA-F]+i64/ :i64)
(defliteral hex   /0x[0-9a-fA-F]+/    :i32)

;; An i64 literal: digits followed by the "i64" suffix.  Must be declared
;; before plain int so the reader tries the longer match first.
(defliteral int64  /-?[0-9]+i64/          :i64)

;; An integer literal: optional minus sign followed by one or more digits → i32.
(defliteral int    /-?[0-9]+/             :i32)

;; An f64 literal: float digits followed by the "f64" suffix.
(defliteral float64 /-?[0-9]*\.[0-9]+f64/ :f64)

;; An f64 literal with scientific notation: e.g. 1.5e-3f64, -2.7e+10f64.
(defliteral float64e /-?[0-9]*\.?[0-9]+[eE][+-]?[0-9]+f64/ :f64)

;; A float literal: optional minus, digits, a decimal point, and more digits → f32.
(defliteral float  /-?[0-9]*\.[0-9]+/    :f32)

;; A float literal with scientific notation: e.g. 1.5e-3, -2.7e+10 → f32.
(defliteral floate /-?[0-9]*\.?[0-9]+[eE][+-]?[0-9]+/ :f32)

;; ── Control flow macros ───────────────────────────────────────────────────────

;; (for i from to body...)
;; Counts i from `from` (inclusive) to `to` (exclusive), step +1.
;; Expands to: (let i :i32 from (while (< i to) body... (set! i (+ i 1))))
(defmacro for (i from to ...body)
  (let i :i32 from
    (while (< i to)
      (macro-do body)
      (set! i (+ i 1)))))


(defop + "i32.add"   (:i32 :i32) :i32)
(defop - "i32.sub"   (:i32 :i32) :i32)
(defop * "i32.mul"   (:i32 :i32) :i32)
(defop / "i32.div_s" (:i32 :i32) :i32)
(defop div  "i32.div_s" (:i32 :i32) :i32)
(defop divu "i32.div_u" (:i32 :i32) :i32)
(defop %    "i32.rem_s" (:i32 :i32) :i32)
(defop %u   "i32.rem_u" (:i32 :i32) :i32)

;; ── i32 bitwise ──────────────────────────────────────────────────────────────
(defop not  "i32.eqz"  (:i32)      :i32)
(defop !    "i32.eqz"  (:i32)      :i32)
(defop band "i32.and"  (:i32 :i32) :i32)
(defop bor  "i32.or"   (:i32 :i32) :i32)
(defop bxor "i32.xor"  (:i32 :i32) :i32)
(defop &    "i32.and"  (:i32 :i32) :i32)
(defop |    "i32.or"   (:i32 :i32) :i32)
(defop ^    "i32.xor"  (:i32 :i32) :i32)
(defop shl  "i32.shl"   (:i32 :i32) :i32)
(defop shr  "i32.shr_s" (:i32 :i32) :i32)
(defop shru "i32.shr_u" (:i32 :i32) :i32)
(defop <<   "i32.shl"   (:i32 :i32) :i32)
(defop >>   "i32.shr_s" (:i32 :i32) :i32)
(defop >>u  "i32.shr_u" (:i32 :i32) :i32)
(defn i32-bnot (x :i32) :i32 (^ x -1))
(defop bnot "i32-bnot" (:i32) :i32)
(defop ~    "i32-bnot" (:i32) :i32)

;; ── i64 bitwise ──────────────────────────────────────────────────────────────
(defop not  "i64.eqz"  (:i64)      :i32)
(defop !    "i64.eqz"  (:i64)      :i32)
(defop band "i64.and"  (:i64 :i64) :i64)
(defop bor  "i64.or"   (:i64 :i64) :i64)
(defop bxor "i64.xor"  (:i64 :i64) :i64)
(defop &    "i64.and"  (:i64 :i64) :i64)
(defop |    "i64.or"   (:i64 :i64) :i64)
(defop ^    "i64.xor"  (:i64 :i64) :i64)
(defop shl  "i64.shl"   (:i64 :i64) :i64)
(defop shr  "i64.shr_s" (:i64 :i64) :i64)
(defop shru "i64.shr_u" (:i64 :i64) :i64)
(defop <<   "i64.shl"   (:i64 :i64) :i64)
(defop >>   "i64.shr_s" (:i64 :i64) :i64)
(defop >>u  "i64.shr_u" (:i64 :i64) :i64)
(defn i64-bnot (x :i64) :i64 (^ x -1i64))
(defop bnot "i64-bnot" (:i64) :i64)
(defop ~    "i64-bnot" (:i64) :i64)

;; ── i32 comparison ───────────────────────────────────────────────────────────
(defop =   "i32.eq"   (:i32 :i32) :i32)
(defop !=  "i32.ne"   (:i32 :i32) :i32)
(defop <   "i32.lt_s" (:i32 :i32) :i32)
(defop >   "i32.gt_s" (:i32 :i32) :i32)
(defop <=  "i32.le_s" (:i32 :i32) :i32)
(defop >=  "i32.ge_s" (:i32 :i32) :i32)
(defop <u  "i32.lt_u" (:i32 :i32) :i32)
(defop >u  "i32.gt_u" (:i32 :i32) :i32)
(defop <=u "i32.le_u" (:i32 :i32) :i32)
(defop >=u "i32.ge_u" (:i32 :i32) :i32)

;; ── i64 arithmetic ───────────────────────────────────────────────────────────
(defop + "i64.add"   (:i64 :i64) :i64)
(defop - "i64.sub"   (:i64 :i64) :i64)
(defop * "i64.mul"   (:i64 :i64) :i64)
(defop / "i64.div_s" (:i64 :i64) :i64)
(defop div  "i64.div_s" (:i64 :i64) :i64)
(defop divu "i64.div_u" (:i64 :i64) :i64)
(defop %    "i64.rem_s" (:i64 :i64) :i64)
(defop %u   "i64.rem_u" (:i64 :i64) :i64)

;; ── i64 comparison ───────────────────────────────────────────────────────────
(defop =   "i64.eq"   (:i64 :i64) :i32)
(defop !=  "i64.ne"   (:i64 :i64) :i32)
(defop <   "i64.lt_s" (:i64 :i64) :i32)
(defop >   "i64.gt_s" (:i64 :i64) :i32)
(defop <=  "i64.le_s" (:i64 :i64) :i32)
(defop >=  "i64.ge_s" (:i64 :i64) :i32)
(defop <u  "i64.lt_u" (:i64 :i64) :i32)
(defop >u  "i64.gt_u" (:i64 :i64) :i32)
(defop <=u "i64.le_u" (:i64 :i64) :i32)
(defop >=u "i64.ge_u" (:i64 :i64) :i32)

;; ── f32 arithmetic ───────────────────────────────────────────────────────────
(defop + "f32.add" (:f32 :f32) :f32)
(defop - "f32.sub" (:f32 :f32) :f32)
(defop * "f32.mul" (:f32 :f32) :f32)
(defop / "f32.div" (:f32 :f32) :f32)

;; ── f32 comparison ───────────────────────────────────────────────────────────
(defop =  "f32.eq" (:f32 :f32) :i32)
(defop != "f32.ne" (:f32 :f32) :i32)
(defop <  "f32.lt" (:f32 :f32) :i32)
(defop >  "f32.gt" (:f32 :f32) :i32)
(defop <= "f32.le" (:f32 :f32) :i32)
(defop >= "f32.ge" (:f32 :f32) :i32)

;; ── f64 arithmetic ───────────────────────────────────────────────────────────
(defop + "f64.add" (:f64 :f64) :f64)
(defop - "f64.sub" (:f64 :f64) :f64)
(defop * "f64.mul" (:f64 :f64) :f64)
(defop / "f64.div" (:f64 :f64) :f64)

;; ── f64 comparison ───────────────────────────────────────────────────────────
(defop =  "f64.eq" (:f64 :f64) :i32)
(defop != "f64.ne" (:f64 :f64) :i32)
(defop <  "f64.lt" (:f64 :f64) :i32)
(defop >  "f64.gt" (:f64 :f64) :i32)
(defop <= "f64.le" (:f64 :f64) :i32)
(defop >= "f64.ge" (:f64 :f64) :i32)

;; Bump allocator with auto-grow — available to all programs via this include.
(include memory)
