;; bench/matmul.woua — 256×256 f64 matrix multiply.
;; Tests floating-point throughput; row-major layout, naive O(n^3) algorithm.
;; Needs ~1.6 MB of WASM memory; grows by 32 pages at startup.
;; Compare: rustc -O bench_matmul.rs -o out/bench_matmul && ./out/bench_matmul

(include io)
(include time)

(defconst MN    256)
(defconst MN2-8 524288)   ;; 256 * 256 * 8  — byte size of one f64 matrix

;; (mat-get base row col) → f64  — row-major access
(defmacro mat-get (base r c)
  (f64.load (+ base (* (+ (* r MN) c) 8))))

;; (mat-set base row col val) → void
(defmacro mat-set (base r c v)
  (f64.store (+ base (* (+ (* r MN) c) 8)) v))

(defn main () :void
  (drop (memory-grow 32))
  (let a :ptr (alloc MN2-8)
    (let b :ptr (alloc MN2-8)
      (let c :ptr (alloc MN2-8)
        ;; Initialise: a[i][j] = i+j,  b[i][j] = i*j,  c[i][j] = 0
        (for i 0 MN
          (for j 0 MN
            (mat-set a i j (as :f64 (+ i j)))
            (mat-set b i j (as :f64 (* i j)))
            (mat-set c i j 0.0f64)))
        ;; Timed matrix multiply
        (let start :i64 (time-now-ns)
          (for i 0 MN
            (for j 0 MN
              (let s :f64 0.0f64
                (for k 0 MN
                  (set! s (+ s (* (mat-get a i k) (mat-get b k j)))))
                (mat-set c i j s))))
          (let elapsed :i64 (- (time-now-ns) start)
(printf "matmul %dx%d in %ld ms, c[1][1]=%ld\n"
              MN MN
              (/ elapsed 1000000i64)
              (as :i64 (mat-get c 1 1)))))))))
