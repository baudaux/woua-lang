;; bench/fib.woua — recursive Fibonacci fib(43): integer recursion, no allocation.
;; Compare: rustc -O bench_fib.rs -o out/bench_fib && ./out/bench_fib

(include io)
(include time)

(defn fib (n :i32) :i32
  (if (< n 2)
    n
    (+ (fib (- n 1)) (fib (- n 2)))))

(defn main () :void
  (let* ((start   :i64 (time-now-ns))
         (result  :i32 (fib 43))
         (elapsed :i64 (- (time-now-ns) start)))
    (printf "fib(43) = %d, time = %ld ms\n"
      result
      (/ elapsed 1000000i64))))